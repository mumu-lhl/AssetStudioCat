<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudioGUI.Avalonia.ViewModels"
        x:Class="AssetStudioGUI.Avalonia.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="620"
        Height="680"
        MinWidth="520"
        MinHeight="390"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="20" RowDefinitions="*,Auto">
    <ScrollViewer Grid.Row="0">
      <StackPanel Spacing="10">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="Loading and cache" />

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Bundle decompression mode" />
        <ComboBox ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}" />
        <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}"
                   Text="Automatic mode uses memory only when the estimated unpacked size fits the conservative memory budget."
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Decompression directory" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding DecompressionDirectory}" IsEnabled="{Binding IsDiskDirectoryEnabled}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" IsEnabled="{Binding IsDiskDirectoryEnabled}" Click="BrowseDecompressionDirectory" />
        </Grid>

        <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}"
                   Text="Temporary decompressed files are isolated per session and removed on exit. The reusable asset index is stored separately below."
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Persistent cache root" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBox Grid.Column="0" Text="{Binding CacheRoot}" />
          <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Click="BrowseCacheRoot" />
        </Grid>

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Override Unity version (optional)" />
        <TextBox Text="{Binding CustomUnityVersion}" PlaceholderText="Example: 2019.4.40f1" />
        <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}"
                   Text="Use only when the game version is stripped or detected incorrectly. Rebuild the index after changing this value."
                   TextWrapping="Wrap" />

        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Preview cache limit (MB)" />
        <NumericUpDown Minimum="32" Maximum="4096" Increment="32" Value="{Binding PreviewCacheMegabytes}" />
        <CheckBox Content="Restore the most recent source at startup" IsChecked="{Binding RestoreLastSource}" />

        <TextBlock Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" Text="Converted export" />
        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="Texture and Sprite image format" />
        <ComboBox ItemsSource="{Binding ImageFormats}" SelectedItem="{Binding SelectedImageFormat}" />
        <CheckBox Content="Apply Sprite alpha mask" IsChecked="{Binding ExportSpriteWithMask}" />
        <CheckBox Content="Convert supported AudioClips to WAV" IsChecked="{Binding ConvertAudioToWav}" />

        <TextBlock Margin="0,18,0,0" FontSize="20" FontWeight="SemiBold" Text="FBX export" />
        <WrapPanel Orientation="Horizontal">
          <CheckBox Margin="0,0,16,6" Content="Animations" IsChecked="{Binding FbxExportAnimations}" />
          <CheckBox Margin="0,0,16,6" Content="Skins" IsChecked="{Binding FbxExportSkins}" />
          <CheckBox Margin="0,0,16,6" Content="BlendShapes" IsChecked="{Binding FbxExportBlendShapes}" />
          <CheckBox Margin="0,0,16,6" Content="All nodes" IsChecked="{Binding FbxExportAllNodes}" />
          <CheckBox Margin="0,0,16,6" Content="Euler filter" IsChecked="{Binding FbxEulerFilter}" />
          <CheckBox Margin="0,0,16,6" Content="ASCII FBX" IsChecked="{Binding FbxAscii}" />
        </WrapPanel>
        <TextBlock FontWeight="SemiBold" Text="FBX scale factor" />
        <NumericUpDown Minimum="0.0001" Maximum="10000" Increment="0.1" Value="{Binding FbxScaleFactor}" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Margin="0,18,0,0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button MinWidth="90" Content="Cancel" Click="Cancel" />
      <Button MinWidth="90" Content="Save" Click="Save" />
    </StackPanel>
  </Grid>
</Window>
