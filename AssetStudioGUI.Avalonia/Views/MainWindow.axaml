<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudioGUI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="AssetStudioGUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Title="{Binding Title}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="Open files…" IsEnabled="False" />
        <MenuItem Header="Open folder…" Click="OpenFolder" />
        <Separator />
        <MenuItem Header="Rebuild index" IsEnabled="{Binding HasSource}" Click="RebuildIndex" />
      </MenuItem>
      <MenuItem Header="_Export" IsEnabled="{Binding HasSelectedAsset}">
        <MenuItem Header="Export raw…" IsEnabled="{Binding CanExport}" Click="ExportRaw" />
        <MenuItem Header="Export complete dump…" IsEnabled="{Binding CanExport}" Click="ExportDump" />
      </MenuItem>
      <MenuItem Header="_Settings" Click="OpenSettings" />
    </Menu>

    <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,260">
        <Button Grid.Column="0" Margin="0,0,8,0" Content="Open files" IsEnabled="False" />
        <Button Grid.Column="1" Margin="0,0,12,0" Content="Open folder" Click="OpenFolder" />
        <TextBox Grid.Column="3" PlaceholderText="Filter by name or container" Text="{Binding SearchText}" KeyUp="FilterKeyUp" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="280,5,*,5,360">
      <TabControl Grid.Column="0">
        <TabItem Header="Scene hierarchy">
          <TextBlock Margin="16" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Open a source directory to build the hierarchy." TextWrapping="Wrap" />
        </TabItem>
        <TabItem Header="Asset classes">
          <TextBlock Margin="16" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="Class structures will appear here." TextWrapping="Wrap" />
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="2*,2*,110,100,100">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Name" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Container" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Type" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Path ID" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Size" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Assets}" SelectionChanged="AssetSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssetRowViewModel">
              <Grid Margin="4,3" ColumnDefinitions="2*,2*,110,100,100">
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Container}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Type}" />
                <TextBlock Grid.Column="3" Text="{Binding PathId}" />
                <TextBlock Grid.Column="4" Text="{Binding Size}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Margin="0,0,8,0" Content="Previous" IsEnabled="{Binding CanGoPrevious}" Click="PreviousPage" />
            <Button Grid.Column="1" Content="Next" IsEnabled="{Binding CanGoNext}" Click="NextPage" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <TabControl Grid.Column="4">
        <TabItem Header="Preview">
          <Grid RowDefinitions="*,Auto,Auto">
            <Border Grid.Row="0" Margin="8" Background="{DynamicResource ThemeBackgroundLowBrush}">
              <Image Source="{Binding PreviewImage}" Stretch="Uniform" />
            </Border>
            <TextBlock Grid.Row="1" Margin="12,6" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                       Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
            <ProgressBar Grid.Row="2" Margin="12,0,12,12" Height="5" IsIndeterminate="True" IsVisible="{Binding IsPreviewBusy}" />
          </Grid>
        </TabItem>
        <TabItem Header="Dump">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8" Orientation="Horizontal" Spacing="8">
              <Button Content="Load dump" IsEnabled="{Binding HasSelectedAsset}" Click="LoadDump" />
              <ProgressBar Width="100" IsIndeterminate="True" IsVisible="{Binding IsDumpBusy}" />
            </StackPanel>
            <TextBox Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True" AcceptsReturn="True"
                     Text="{Binding DumpText}" TextWrapping="NoWrap" FontFamily="monospace" />
          </Grid>
        </TabItem>
        <TabItem Header="Information">
          <TextBlock Margin="16" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding AssetInformation}" TextWrapping="Wrap" />
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" Padding="10,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,220">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding DecompressionSummary}" />
        <ProgressBar Grid.Column="2" Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
