<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudioGUI.Avalonia.ViewModels"
        xmlns:controls="using:AssetStudioGUI.Avalonia.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="AssetStudioGUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Title="{Binding Title}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="{Binding L[File]}">
        <MenuItem Header="{Binding L[OpenFiles]}" Click="OpenFiles" />
        <MenuItem Header="{Binding L[OpenFolder]}" Click="OpenFolder" />
        <MenuItem Header="{Binding L[OpenMostRecent]}" IsEnabled="{Binding CanOpenRecent}" Click="OpenMostRecent" />
        <Separator />
        <MenuItem Header="{Binding L[ExtractOpenedBundles]}" IsEnabled="{Binding HasSource}" Click="ExtractOpenedSources" />
        <MenuItem Header="{Binding L[RebuildIndex]}" IsEnabled="{Binding HasSource}" Click="RebuildIndex" />
      </MenuItem>
      <MenuItem Header="{Binding L[Export]}" IsEnabled="{Binding HasSource}">
        <MenuItem Header="{Binding L[ExportAssetListCsv]}" Click="ExportAssetListCsv" />
        <MenuItem Header="{Binding L[ExportAssetListJson]}" Click="ExportAssetListJson" />
        <Separator />
        <MenuItem Header="{Binding L[ExportConverted]}" IsEnabled="{Binding CanExport}" Click="ExportConverted" />
        <MenuItem Header="{Binding L[ExportRaw]}" IsEnabled="{Binding CanExport}" Click="ExportRaw" />
        <MenuItem Header="{Binding L[ExportDump]}" IsEnabled="{Binding CanExport}" Click="ExportDump" />
        <Separator />
        <MenuItem Header="{Binding L[ExportAnimator]}" IsEnabled="{Binding CanExportAnimator}" Click="ExportAnimator" />
        <MenuItem Header="{Binding L[ExportSceneModel]}" IsEnabled="{Binding CanExportSceneModel}" Click="ExportSceneModel" />
        <Separator />
        <MenuItem Header="{Binding L[BatchConverted]}">
          <MenuItem Header="{Binding L[SelectedObjects]}" IsEnabled="{Binding HasBatchSelection}" Click="BatchConvertedSelected" />
          <MenuItem Header="{Binding L[FilteredObjects]}" IsEnabled="{Binding HasSource}" Click="BatchConvertedFiltered" />
        </MenuItem>
        <MenuItem Header="{Binding L[BatchRaw]}">
          <MenuItem Header="{Binding L[SelectedObjects]}" IsEnabled="{Binding HasBatchSelection}" Click="BatchRawSelected" />
          <MenuItem Header="{Binding L[FilteredObjects]}" IsEnabled="{Binding HasSource}" Click="BatchRawFiltered" />
        </MenuItem>
        <MenuItem Header="{Binding L[BatchDump]}">
          <MenuItem Header="{Binding L[SelectedObjects]}" IsEnabled="{Binding HasBatchSelection}" Click="BatchDumpSelected" />
          <MenuItem Header="{Binding L[FilteredObjects]}" IsEnabled="{Binding HasSource}" Click="BatchDumpFiltered" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="{Binding L[Settings]}" Click="OpenSettings" />
      <MenuItem Header="{Binding L[CacheManager]}" Click="OpenCacheManager" />
    </Menu>

    <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,180,260">
        <Button Grid.Column="0" Margin="0,0,8,0" Content="{Binding L[OpenFiles]}" Click="OpenFiles" />
        <Button Grid.Column="1" Margin="0,0,12,0" Content="{Binding L[OpenFolder]}" Click="OpenFolder" />
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
          <TextBlock VerticalAlignment="Center" Text="{Binding L[Sort]}" />
          <ComboBox Width="110" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}" SelectionChanged="SortChanged" />
          <CheckBox VerticalAlignment="Center" Content="{Binding L[Descending]}" IsChecked="{Binding SortDescending}" Click="SortDirectionChanged" />
        </StackPanel>
        <ComboBox Grid.Column="3" Margin="0,0,8,0" ItemsSource="{Binding AssetTypes}" SelectedItem="{Binding SelectedType}" SelectionChanged="TypeFilterChanged" />
        <TextBox Grid.Column="4" PlaceholderText="{Binding L[FilterByName]}" Text="{Binding SearchText}" KeyUp="FilterKeyUp" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="280,5,*,5,360">
      <TabControl Grid.Column="0">
        <TabItem Header="{Binding L[SceneHierarchy]}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8" Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[LoadHierarchy]}" IsEnabled="{Binding HasSource}" Click="LoadHierarchy" />
              <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsHierarchyBusy}" />
            </StackPanel>
            <TreeView Grid.Row="1" Margin="4" ItemsSource="{Binding SceneRoots}" SelectionChanged="SceneSelectionChanged">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:SceneNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding Details}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[AssetClasses]}">
          <ListBox Margin="4" ItemsSource="{Binding AssetClasses}" SelectionChanged="AssetClassSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetClassRowViewModel">
                <Grid Margin="4,3" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding TypeName}" />
                  <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding Count}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="2*,2*,110,100,100">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="{Binding L[Name]}" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding L[Container]}" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding L[Type]}" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="{Binding L[PathId]}" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="{Binding L[SizeMegabytes]}" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Assets}" SelectionMode="Multiple" SelectionChanged="AssetSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssetRowViewModel">
              <Grid Margin="4,3" ColumnDefinitions="2*,2*,110,100,100">
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Container}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Type}" />
                <TextBlock Grid.Column="3" Text="{Binding PathId}" />
                <TextBlock Grid.Column="4" Text="{Binding SizeMegabytes}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Margin="0,0,8,0" Content="{Binding L[Previous]}" IsEnabled="{Binding CanGoPrevious}" Click="PreviousPage" />
            <Button Grid.Column="1" Content="{Binding L[Next]}" IsEnabled="{Binding CanGoNext}" Click="NextPage" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <TabControl Grid.Column="4">
        <TabItem Header="{Binding L[Preview]}">
          <Grid RowDefinitions="*,Auto,Auto">
            <Border Grid.Row="0" Margin="8" Background="{DynamicResource ThemeBackgroundLowBrush}">
              <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding ShowPreviewImage}" />
                <Grid IsVisible="{Binding HasPreviewMesh}">
                  <controls:MeshViewportControl Name="MeshViewport"
                                                MeshGeometry="{Binding PreviewMeshGeometry}"
                                                WireframeMode="{Binding MeshWireframeMode}"
                                                ShadeMode="{Binding MeshShadeMode}"
                                                UseCalculatedNormals="{Binding MeshUseCalculatedNormals}" />
                  <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="8"
                          Background="#D0202328" CornerRadius="6" Padding="6,4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button Content="{Binding MeshWireframeButtonText}" Click="CycleMeshWireframe" Padding="8,4" />
                      <Button Content="{Binding MeshShadeButtonText}" Click="CycleMeshShade" Padding="8,4" />
                      <Button Content="{Binding MeshNormalsButtonText}" Click="ToggleMeshNormals" Padding="8,4" />
                      <Button Content="{Binding L[ResetCamera]}" Click="ResetMeshCamera" Padding="8,4" />
                    </StackPanel>
                  </Border>
                  <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="8"
                          Background="#B016181B" CornerRadius="4" Padding="8,3">
                    <TextBlock Text="{Binding L[MeshInteractionTip]}"
                               FontSize="11" Foreground="#DDD" />
                  </Border>
                </Grid>
                <TextBox Margin="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="monospace" Text="{Binding PreviewText}" IsVisible="{Binding HasPreviewText}" />
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" Margin="12,6" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                       Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Margin="12,0,12,12" Spacing="6">
              <Button HorizontalAlignment="Center" Content="{Binding L[PlayInSystemPlayer]}" IsEnabled="{Binding CanPlayAudio}" IsVisible="{Binding CanPlayAudio}" Click="PlayAudio" />
              <ProgressBar Height="5" IsIndeterminate="True" IsVisible="{Binding IsPreviewBusy}" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[Dump]}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8" Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[LoadDump]}" IsEnabled="{Binding HasSelectedAsset}" Click="LoadDump" />
              <ProgressBar Width="100" IsIndeterminate="True" IsVisible="{Binding IsDumpBusy}" />
            </StackPanel>
            <TextBox Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True" AcceptsReturn="True"
                     Text="{Binding DumpText}" TextWrapping="NoWrap" FontFamily="monospace" />
          </Grid>
        </TabItem>
        <TabItem Header="{Binding L[Information]}">
          <TextBlock Margin="16" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding AssetInformation}" TextWrapping="Wrap" />
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" Padding="10,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,220">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding DecompressionSummary}" />
        <StackPanel Grid.Column="2" Margin="0,0,8,0" Orientation="Horizontal" Spacing="6">
          <Button Padding="10,2" Content="{Binding L[CancelLoad]}" IsVisible="{Binding IsBusy}" Click="CancelLoad" />
          <Button Padding="10,2" Content="{Binding L[CancelExport]}" IsVisible="{Binding IsBatchExportBusy}" Click="CancelExport" />
          <Button Padding="10,2" Content="{Binding L[CancelExtraction]}" IsVisible="{Binding IsExtractionBusy}" Click="CancelExport" />
        </StackPanel>
        <ProgressBar Grid.Column="3" Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
