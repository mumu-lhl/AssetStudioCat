<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AssetStudioGUI.Avalonia.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1280"
        d:DesignHeight="760"
        x:Class="AssetStudioGUI.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        Title="{Binding Title}">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Menu Grid.Row="0">
      <MenuItem Header="_File">
        <MenuItem Header="Open files…" Click="OpenFiles" />
        <MenuItem Header="Open folder…" Click="OpenFolder" />
        <MenuItem Header="Open most recent" IsEnabled="{Binding CanOpenRecent}" Click="OpenMostRecent" />
        <Separator />
        <MenuItem Header="Rebuild index" IsEnabled="{Binding HasSource}" Click="RebuildIndex" />
      </MenuItem>
      <MenuItem Header="_Export" IsEnabled="{Binding HasSource}">
        <MenuItem Header="Export converted…" IsEnabled="{Binding CanExport}" Click="ExportConverted" />
        <MenuItem Header="Export raw…" IsEnabled="{Binding CanExport}" Click="ExportRaw" />
        <MenuItem Header="Export complete dump…" IsEnabled="{Binding CanExport}" Click="ExportDump" />
        <Separator />
        <MenuItem Header="Export Animator as FBX…" IsEnabled="{Binding CanExportAnimator}" Click="ExportAnimator" />
        <MenuItem Header="Export selected scene model as FBX…" IsEnabled="{Binding CanExportSceneModel}" Click="ExportSceneModel" />
        <Separator />
        <MenuItem Header="Batch converted">
          <MenuItem Header="Selected objects…" IsEnabled="{Binding HasBatchSelection}" Click="BatchConvertedSelected" />
          <MenuItem Header="Filtered objects…" IsEnabled="{Binding HasSource}" Click="BatchConvertedFiltered" />
        </MenuItem>
        <MenuItem Header="Batch raw">
          <MenuItem Header="Selected objects…" IsEnabled="{Binding HasBatchSelection}" Click="BatchRawSelected" />
          <MenuItem Header="Filtered objects…" IsEnabled="{Binding HasSource}" Click="BatchRawFiltered" />
        </MenuItem>
        <MenuItem Header="Batch dump">
          <MenuItem Header="Selected objects…" IsEnabled="{Binding HasBatchSelection}" Click="BatchDumpSelected" />
          <MenuItem Header="Filtered objects…" IsEnabled="{Binding HasSource}" Click="BatchDumpFiltered" />
        </MenuItem>
      </MenuItem>
      <MenuItem Header="_Settings" Click="OpenSettings" />
      <MenuItem Header="_Cache manager" Click="OpenCacheManager" />
    </Menu>

    <Border Grid.Row="1" Padding="10,8" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,Auto,*,180,260">
        <Button Grid.Column="0" Margin="0,0,8,0" Content="Open files" Click="OpenFiles" />
        <Button Grid.Column="1" Margin="0,0,12,0" Content="Open folder" Click="OpenFolder" />
        <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
          <TextBlock VerticalAlignment="Center" Text="Sort" />
          <ComboBox Width="110" ItemsSource="{Binding SortFields}" SelectedItem="{Binding SelectedSortField}" SelectionChanged="SortChanged" />
          <CheckBox VerticalAlignment="Center" Content="Descending" IsChecked="{Binding SortDescending}" Click="SortDirectionChanged" />
        </StackPanel>
        <ComboBox Grid.Column="3" Margin="0,0,8,0" ItemsSource="{Binding AssetTypes}" SelectedItem="{Binding SelectedType}" SelectionChanged="TypeFilterChanged" />
        <TextBox Grid.Column="4" PlaceholderText="Filter by name or container" Text="{Binding SearchText}" KeyUp="FilterKeyUp" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="280,5,*,5,360">
      <TabControl Grid.Column="0">
        <TabItem Header="Scene hierarchy">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8" Orientation="Horizontal" Spacing="8">
              <Button Content="Load hierarchy" IsEnabled="{Binding HasSource}" Click="LoadHierarchy" />
              <ProgressBar Width="80" IsIndeterminate="True" IsVisible="{Binding IsHierarchyBusy}" />
            </StackPanel>
            <TreeView Grid.Row="1" Margin="4" ItemsSource="{Binding SceneRoots}" SelectionChanged="SceneSelectionChanged">
              <TreeView.ItemTemplate>
                <TreeDataTemplate x:DataType="vm:SceneNodeViewModel" ItemsSource="{Binding Children}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding Details}" />
                  </StackPanel>
                </TreeDataTemplate>
              </TreeView.ItemTemplate>
            </TreeView>
          </Grid>
        </TabItem>
        <TabItem Header="Asset classes">
          <ListBox Margin="4" ItemsSource="{Binding AssetClasses}" SelectionChanged="AssetClassSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:AssetClassRowViewModel">
                <Grid Margin="4,3" ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding TypeName}" />
                  <TextBlock Grid.Column="1" Margin="8,0,0,0" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding Count}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <Grid Grid.Column="2" RowDefinitions="Auto,*,Auto">
        <Border Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="2*,2*,110,100,100">
            <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Name" />
            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Container" />
            <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Type" />
            <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Path ID" />
            <TextBlock Grid.Column="4" FontWeight="SemiBold" Text="Size" />
          </Grid>
        </Border>
        <ListBox Grid.Row="1" ItemsSource="{Binding Assets}" SelectionMode="Multiple" SelectionChanged="AssetSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:AssetRowViewModel">
              <Grid Margin="4,3" ColumnDefinitions="2*,2*,110,100,100">
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Container}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding Type}" />
                <TextBlock Grid.Column="3" Text="{Binding PathId}" />
                <TextBlock Grid.Column="4" Text="{Binding Size}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Padding="8,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
          <Grid ColumnDefinitions="Auto,Auto,*">
            <Button Grid.Column="0" Margin="0,0,8,0" Content="Previous" IsEnabled="{Binding CanGoPrevious}" Click="PreviousPage" />
            <Button Grid.Column="1" Content="Next" IsEnabled="{Binding CanGoNext}" Click="NextPage" />
            <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding PageSummary}" />
          </Grid>
        </Border>
      </Grid>

      <GridSplitter Grid.Column="3" ResizeDirection="Columns" />

      <TabControl Grid.Column="4">
        <TabItem Header="Preview">
          <Grid RowDefinitions="*,Auto,Auto">
            <Border Grid.Row="0" Margin="8" Background="{DynamicResource ThemeBackgroundLowBrush}">
              <Grid>
                <Image Source="{Binding PreviewImage}" Stretch="Uniform" IsVisible="{Binding HasPreviewImage}" />
                <TextBox Margin="8" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         FontFamily="monospace" Text="{Binding PreviewText}" IsVisible="{Binding HasPreviewText}" />
              </Grid>
            </Border>
            <TextBlock Grid.Row="1" Margin="12,6" HorizontalAlignment="Center"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                       Text="{Binding PreviewMessage}" TextWrapping="Wrap" />
            <StackPanel Grid.Row="2" Margin="12,0,12,12" Spacing="6">
              <Button HorizontalAlignment="Center" Content="Play in system player" IsEnabled="{Binding CanPlayAudio}" IsVisible="{Binding CanPlayAudio}" Click="PlayAudio" />
              <ProgressBar Height="5" IsIndeterminate="True" IsVisible="{Binding IsPreviewBusy}" />
            </StackPanel>
          </Grid>
        </TabItem>
        <TabItem Header="Dump">
          <Grid RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Margin="8" Orientation="Horizontal" Spacing="8">
              <Button Content="Load dump" IsEnabled="{Binding HasSelectedAsset}" Click="LoadDump" />
              <ProgressBar Width="100" IsIndeterminate="True" IsVisible="{Binding IsDumpBusy}" />
            </StackPanel>
            <TextBox Grid.Row="1" Margin="8,0,8,8" IsReadOnly="True" AcceptsReturn="True"
                     Text="{Binding DumpText}" TextWrapping="NoWrap" FontFamily="monospace" />
          </Grid>
        </TabItem>
        <TabItem Header="Information">
          <TextBlock Margin="16" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding AssetInformation}" TextWrapping="Wrap" />
        </TabItem>
      </TabControl>
    </Grid>

    <Border Grid.Row="3" Padding="10,6" BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto,220">
        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText}" />
        <TextBlock Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource ThemeForegroundLowBrush}" Text="{Binding DecompressionSummary}" />
        <StackPanel Grid.Column="2" Margin="0,0,8,0" Orientation="Horizontal" Spacing="6">
          <Button Padding="10,2" Content="Cancel load" IsVisible="{Binding IsBusy}" Click="CancelLoad" />
          <Button Padding="10,2" Content="Cancel export" IsVisible="{Binding IsBatchExportBusy}" Click="CancelExport" />
        </StackPanel>
        <ProgressBar Grid.Column="3" Height="12" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" IsVisible="{Binding IsBusy}" />
      </Grid>
    </Border>
  </Grid>
</Window>
